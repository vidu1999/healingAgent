# SentinelOps AI environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# Backend expects to run from the backend/ directory.

APP_ENV=development            # development | production | demo

# Database: sqlite dev fallback (documented) | postgresql production
DATABASE_URL=sqlite:///./sentinelops.db
# DATABASE_URL=postgresql+psycopg://sentinelops:sentinelops@localhost:5432/sentinelops
REDIS_URL=redis://localhost:6379/0

# Ollama local inference (never paid cloud AI)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=codellama:7b-instruct
OLLAMA_CONTEXT_SIZE=4096
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_CONCURRENT_REQUESTS=1
AI_CLOUD_FALLBACK=false
DEMO_MODE=false

# Auth & sessions - generate real secrets for production
SECRET_KEY=dev-insecure-change-me
SESSION_SECRET=dev-insecure-change-me
SESSION_COOKIE_NAME=sentinelops_session
SESSION_COOKIE_SECURE=false          # true when served over HTTPS
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=86400

# GitHub integration (read-only by default)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_ALLOWLIST_REPOS=
GITHUB_READ_ONLY=true
GITHUB_API_BASE_URL=https://api.github.com

# Log monitoring roots (semicolon-separated). Never credential directories.
# Example Windows: LOG_MONITORING_ROOTS=C:\Logs\app;C:\Logs\infra
# Example Linux:   LOG_MONITORING_ROOTS=/var/log/app;/var/log/infra
LOG_MONITORING_ROOTS=
LOG_RETENTION_DAYS=30
LOG_MAX_RECORD_SIZE=1048576
LOG_INGESTION_RATE=100/s

# Sandbox worker (Docker)
SANDBOX_IMAGE=sentinelops-worker:latest
SANDBOX_CPU_LIMIT=1
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_NETWORK_DISABLED=true
SANDBOX_TIMEOUT_SECONDS=300

# Approvals
APPROVAL_LIFETIME_SECONDS=3600

# Audit
AUDIT_RETENTION_DAYS=90
